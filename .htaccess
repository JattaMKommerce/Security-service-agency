Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect any main domain folder visits (/security/) to the dedicated subdomain
    RewriteCond %{HTTP_HOST} ^(www\.)?jattamkommerce\.com$ [NC]
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^(.*)$ https://security.jattamkommerce.com/$1 [L,R=301]

    # Force HTTPS: phone GPS (Geolocation API) only works on https://
    # Comment these 4 lines out only if SSL is not yet active on the domain.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block direct access to private folders
    RewriteRule ^(config|includes|database|storage|android)(/|$) - [F,L]
</IfModule>

# App signing keys must never be downloadable (they let anyone sign a fake app update)
<FilesMatch "\.(keystore|jks|p12|pem|key)$|^signing-key-info\.txt$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Never serve these file types directly
<FilesMatch "\.(sql|md|lock|log|ini|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # camera=(self) is needed for the duty selfie in the guard app
    Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>
